#!/bin/sh
#
# Keep ?v= cache-buster stamps correct at commit time.
#
# A stamp is a function of the file it stamps, so the only way it goes wrong is
# somebody editing an asset and not retyping the digest. That failure is silent
# — the deploy succeeds, the page loads, and visitors keep the cached old file
# — which is why check:cachebust exists at all. Running the fix here closes the
# window before the commit is written, rather than after CI has gone red.
#
# Install with:  npm run hooks:install
# Bypass with:   git commit --no-verify
#
# ── Why this is careful about `git add` ──
#
# The stamp usually does not live in the file you edited. Change app.js and the
# stale stamp is in index.html, which you never staged. Staging it for you is
# the whole point — a commit carrying the asset without the bump is precisely
# the bug. But if that page also has unrelated edits you deliberately left
# unstaged, `git add` would sweep them into the commit behind your back.
#
# So the hook stages a repaired file only when it had nothing unstaged to lose.
# Anything else is reported and left alone, for you to resolve deliberately.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ── Whole-index commits in the shared checkout ──
#
# This runs BEFORE the cache-buster pass on purpose. That pass rewrites files,
# and when a commit is going to be refused it should be refused without having
# edited anything first — a blocked commit once left corrected stamps in another
# session's in-progress pages as a side effect.
#
# The primary worktree is the shared one: it is where a second session lands by
# default, and its index is the one two agents can both stage into. That is not
# hypothetical. A `git add` of one session's paths came back showing the other
# session's files too, already staged, and a bare `git commit` would have taken
# both under the wrong message.
#
# Linked worktrees each have their OWN index, so they are not the hazard and are
# not checked — their existence is simply the signal that this clone is being
# used by more than one checkout, and that the primary tree is now shared ground.
#
# A path-limited `git commit <paths>` is safe by construction: git builds a
# temporary index holding only those paths, so it cannot sweep up anything else.
# Detected by the index git points us at not being the repo's real one, which is
# more durable than matching git's temp-file name.
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ]; then
	worktrees=$(git worktree list --porcelain | grep -c '^worktree ')

	if [ "$worktrees" -gt 1 ] && [ "${MC_PRIMARY_COMMIT:-0}" != "1" ]; then
		index_name=$(basename "${GIT_INDEX_FILE:-index}")

		if [ "$index_name" = "index" ]; then
			staged=$(git diff --cached --name-only)
			count=$(printf '%s\n' "$staged" | grep -c . || true)

			echo "" >&2
			echo "pre-commit: refusing a whole-index commit in the primary worktree." >&2
			echo "" >&2
			echo "            This clone has $worktrees checkouts, so feature work belongs in a" >&2
			echo "            worktree and the primary tree is shared ground. A bare commit" >&2
			echo "            here records everything staged — including anything a second" >&2
			echo "            session staged into the same index." >&2
			echo "" >&2
			echo "            Staged right now ($count file(s)):" >&2
			printf '%s\n' "$staged" | head -20 | sed 's/^/              /' >&2
			if [ "$count" -gt 20 ]; then
				echo "              ... and $((count - 20)) more" >&2
			fi
			echo "" >&2
			echo "            Scope it to your own paths — git builds a temporary index for" >&2
			echo "            those, so nothing else can ride along:" >&2
			echo "              git commit -- <paths>" >&2
			echo "" >&2
			echo "            Or, if the whole index is definitely yours:" >&2
			echo "              MC_PRIMARY_COMMIT=1 git commit" >&2
			echo "" >&2
			echo "            Worktrees open:" >&2
			git worktree list | sed 's/^/              /' >&2
			exit 1
		fi
	fi
fi

command -v node >/dev/null 2>&1 || {
	echo "pre-commit: node not found, skipping cache-buster fix" >&2
	exit 0
}

# Files carrying unstaged changes *before* the fix runs. Staging one of these
# later would commit more than the stamp.
dirty_before=$(git diff --name-only)

output=$(node scripts/check-cache-busters.mjs --fix 2>&1) || {
	# A missing file, or any other hard failure, is not something --fix repairs.
	echo "$output" >&2
	echo "" >&2
	echo "pre-commit: cache-buster check failed and could not be fixed automatically." >&2
	echo "            Resolve the above, or commit with --no-verify to skip." >&2
	exit 1
}

repaired=$(echo "$output" | sed -n 's/^FIXED  *//p')

if [ -n "$repaired" ]; then
	echo "$output" | grep -E '^(FIXED|  *->)' || true

	held_back=""
	for file in $repaired; do
		if echo "$dirty_before" | grep -qx "$file"; then
			held_back="$held_back $file"
		else
			git add -- "$file"
		fi
	done

	if [ -n "$held_back" ]; then
		echo "" >&2
		echo "pre-commit: these files already had unstaged changes, so their corrected" >&2
		echo "            stamps were written but NOT staged — review and add them:" >&2
		for file in $held_back; do echo "              $file" >&2; done
		exit 1
	fi

	echo "pre-commit: stamps corrected and staged."
fi

# Having repaired nothing is not the same as being safe to commit. A corrected
# stamp can already be sitting unstaged — written by the block above on an
# earlier attempt, or edited by hand. The fix pass then finds nothing stale,
# and without this the commit would sail through recording the asset and not
# its bump: precisely the bug the hook exists to prevent, one retry later.
#
# The invariant is about the index, not the working tree. Any stamp that
# differs between the two means the commit is about to record a number that
# disagrees with the file on disk.
#
# SCOPED TO WHAT THIS COMMIT RECORDS. Looking at every page in the tree made the
# hook refuse commits it had no business refusing: a straddled stamp in a file
# the commit does not touch cannot be recorded by it, so it is somebody else's
# problem — and in a repo where more than one thing is in flight at once, there
# is usually somebody else. `git diff --cached` is the right source because git
# points the hook at the index it built for THIS commit, including the temporary
# one it builds for a path-limited `git commit <paths>`.
#
# Word-split on whitespace, as the repaired loop above already does; no path in
# this repo has a space in it.
staged_pages=$(git diff --cached --name-only --diff-filter=ACMR -- '*.html' '*.css')

straddled=''
if [ -n "$staged_pages" ]; then
	straddled=$(git diff -U0 -- $staged_pages |
		grep -E '^[+-].*\?v=[0-9a-f]{8}' |
		head -20 || true)
fi

if [ -n "$straddled" ]; then
	echo "" >&2
	echo "pre-commit: a corrected ?v= stamp is in the working tree but not staged," >&2
	echo "            so this commit would record the old one:" >&2
	echo "$straddled" | sed 's/^/              /' >&2
	echo "" >&2
	echo "            Stage the file, or discard the change — then commit again." >&2
	exit 1
fi

exit 0
