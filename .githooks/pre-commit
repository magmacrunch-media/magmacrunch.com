#!/bin/sh
#
# Keep ?v= cache-buster stamps correct at commit time.
#
# A stamp is a function of the file it stamps, so the only way it goes wrong is
# somebody editing an asset and not retyping the digest. That failure is silent
# — the deploy succeeds, the page loads, and visitors keep the cached old file
# — which is why check:cachebust exists at all. Checking here closes the
# window before the commit is written, rather than after CI has gone red.
#
# Install with:  npm run hooks:install
# Bypass with:   git commit --no-verify
#
# ── What it checks, and what it will stage ──
#
# scripts/check-staged-stamps.mjs does the work, against the tree this commit
# records rather than the files on disk; its header has the rule and the
# history. In short, a commit answers for every stamp it records either end of
# — the page, or the file the stamp names — and for nothing else.
#
# The stamp usually does not live in the file you edited. Change app.js and the
# stale stamp is in index.html, which you never staged. So the hook corrects
# it, but only in a page whose working copy has nothing else to lose, and then:
#
#   git commit                stages the correction, and the commit proceeds
#   git commit -- <paths>     refuses with the correction on disk; commit
#                             again with the page added to the pathspec
#
# A scoped commit cannot be widened from inside a hook without leaving the real
# index disagreeing with HEAD, so one re-run is the price of scoping, and the
# refusal names the paths to add.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ── Whole-index commits in the shared checkout ──
#
# This runs BEFORE the cache-buster pass on purpose. That pass rewrites files,
# and when a commit is going to be refused it should be refused without having
# edited anything first — a blocked commit once left corrected stamps in another
# session's in-progress pages as a side effect.
#
# The primary worktree is the shared one: it is where a second session lands by
# default, and its index is the one two agents can both stage into. That is not
# hypothetical. A `git add` of one session's paths came back showing the other
# session's files too, already staged, and a bare `git commit` would have taken
# both under the wrong message.
#
# Linked worktrees each have their OWN index, so they are not the hazard and are
# not checked — their existence is simply the signal that this clone is being
# used by more than one checkout, and that the primary tree is now shared ground.
#
# A path-limited `git commit <paths>` is safe by construction: git builds a
# temporary index holding only those paths, so it cannot sweep up anything else.
#
# The index git points us at says which kind of commit this is — the same test
# the stamps section below makes. A bare `git commit` runs hooks against the
# real index (`index`); `-a` and `-i <paths>` run them against its lock file
# (`index.lock`), which is the whole index plus whatever they just staged into
# it. Both are whole-index commits. A path-limited commit gets a temporary
# `next-index-*.lock` instead, and is let through.
#
# `-a` is the worst case this guard exists for — it stages every tracked change
# in the tree, another session's included, without showing anybody first — and
# it was the one getting through until `index.lock` was matched here too.
# Refusing it costs nothing: git discards the lock when the hook fails, so the
# real index is left exactly as it was.
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ]; then
	worktrees=$(git worktree list --porcelain | grep -c '^worktree ')

	if [ "$worktrees" -gt 1 ] && [ "${MC_PRIMARY_COMMIT:-0}" != "1" ]; then
		case "$(basename "${GIT_INDEX_FILE:-index}")" in
			index | index.lock) whole_index=1 ;;
			*)                  whole_index=0 ;;
		esac

		if [ "$whole_index" = 1 ]; then
			staged=$(git diff --cached --name-only)
			count=$(printf '%s\n' "$staged" | grep -c . || true)

			echo "" >&2
			echo "pre-commit: refusing a whole-index commit in the primary worktree." >&2
			echo "" >&2
			echo "            This clone has $worktrees checkouts, so feature work belongs in a" >&2
			echo "            worktree and the primary tree is shared ground. A bare commit" >&2
			echo "            here records everything staged — including anything a second" >&2
			echo "            session staged into the same index — and -a adds every" >&2
			echo "            tracked change in the tree on top." >&2
			echo "" >&2
			echo "            This commit would record ($count file(s)):" >&2
			printf '%s\n' "$staged" | head -20 | sed 's/^/              /' >&2
			if [ "$count" -gt 20 ]; then
				echo "              ... and $((count - 20)) more" >&2
			fi
			echo "" >&2
			echo "            Scope it to your own paths — git builds a temporary index for" >&2
			echo "            those, so nothing else can ride along:" >&2
			echo "              git commit -- <paths>" >&2
			echo "" >&2
			echo "            Or, if the whole index is definitely yours:" >&2
			echo "              MC_PRIMARY_COMMIT=1 git commit" >&2
			echo "" >&2
			echo "            Worktrees open:" >&2
			git worktree list | sed 's/^/              /' >&2
			exit 1
		fi
	fi
fi

command -v node >/dev/null 2>&1 || {
	echo "pre-commit: node not found, skipping the cache-buster check" >&2
	exit 0
}

# ── Stamps ──
#
# This used to run check-cache-busters.mjs --fix over the whole working tree,
# then work out in shell which of the files it had rewritten it could stage.
# Each rule that grew here (1772747, 0a184c6b, 45ed9d5a) patched one more way
# the working tree differs from the commit, and three kinds of commit still got
# through to a red CI — one of them an asset committed alone by pathspec, the
# recommended way to commit in this checkout. The straddle guard that followed
# has gone as well: it approximated from the working tree what the script now
# checks directly on the index, and it refused commits whose recorded stamps
# were right.
#
# The index git hands us says what kind of commit this is. A plain
# `git commit` runs hooks against the real index (`index`), and `-a` or
# `-i <paths>` against its lock file (`index.lock`), which git then installs as
# the real index — either can be staged into. `git commit -- <paths>` runs them
# against a temporary index, which cannot.
case "$(basename "${GIT_INDEX_FILE:-index}")" in
	index | index.lock) exec node scripts/check-staged-stamps.mjs --stage ;;
	*)                  exec node scripts/check-staged-stamps.mjs ;;
esac
