{
  "name": "magmacrunch-website",
  "private": true,
  "description": "magmacrunch media \u2014 dev tooling only, no build step",
  "scripts": {
    "lint": "eslint nav.js assets/*.js templates/*.js",
    "lint:fix": "eslint --fix nav.js assets/*.js templates/*.js",
    "lint:all": "eslint nav.js assets/*.js templates/*.js 'arcade/**/js/*.js'",
    "test:py": "find arcade -name 'test_*.py' -exec dirname {} \\; | sort -u | while read dir; do echo \"=== $dir ===\" && cd \"$dir\" && pytest -v --tb=short && cd \"$OLDPWD\"; done",
    "test:js": "find arcade -name 'test-*.js' -path '*/tests/*' -exec node {} \\;",
    "test": "npm run lint && npm run test:js",
    "build-search": "node scripts/build-search-index.js",
    "og": "node scripts/generate-og.mjs",
    "build:adenosine": "node scripts/sync-adenosine.mjs"
  },
  "dependencies": {
    "@magmacrunch/adenosine-audio": "^0.2.1",
    "@magmacrunch/adenosine-cards": "^0.2.1",
    "@magmacrunch/adenosine-puzzle": "^0.2.0",
    "@magmacrunch/adenosine-rpg": "^0.2.0",
    "@magmacrunch/adenosine-score-client": "^0.2.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.62",
    "eslint": "^8.56.0",
    "sharp": "^0.35.3"
  }
}