{
  "name": "magmacrunch-website",
  "private": true,
  "description": "magmacrunch media — dev tooling only, no build step",
  "scripts": {
    "lint": "eslint nav.js assets/*.js templates/*.js ware/shell/*.js",
    "lint:fix": "eslint --fix nav.js assets/*.js templates/*.js ware/shell/*.js",
    "lint:all": "eslint nav.js assets/*.js templates/*.js ware/shell/*.js 'arcade/**/js/*.js'",
    "test:py": "node scripts/run-tests.mjs py",
    "test:js": "node scripts/run-tests.mjs js",
    "test": "npm run lint && npm run test:js",
    "check": "npm run lint && npm run check:shell && npm run check:cachebust && npm run test:py && npm run test:js",
    "build-search": "node scripts/build-search-index.js",
    "og": "node scripts/generate-og.mjs",
    "build:adenosine": "node scripts/sync-adenosine.mjs",
    "check:shell": "node scripts/check-shell-tokens.mjs",
    "check:cachebust": "node scripts/check-cache-busters.mjs",
    "worktree": "node scripts/worktree.mjs",
    "fix:cachebust": "node scripts/check-cache-busters.mjs --fix",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@magmacrunch/adenosine-audio": "^0.2.4",
    "@magmacrunch/adenosine-cards": "^0.9.0",
    "@magmacrunch/adenosine-chat": "^0.4.4",
    "@magmacrunch/adenosine-multiplayer": "^0.4.5",
    "@magmacrunch/adenosine-puzzle": "^0.2.5",
    "@magmacrunch/adenosine-rpg": "^0.2.3",
    "@magmacrunch/adenosine-score-client": "^0.2.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.62",
    "eslint": "^8.56.0",
    "sharp": "^0.35.3"
  }
}
